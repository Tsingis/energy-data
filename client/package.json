{
  "name": "energy-data",
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "predev": "node check-packages.js",
    "dev": "vite --config ./vite.config.ts --open",
    "dev:check": "vite --config ./vite.config.ts --open -- --use-checker",
    "preview": "vite preview --config ./vite.config.ts",
    "test": "vitest --config vitest.config.ts",
    "playwright:setup": "npx playwright install --with-deps",
    "playwright": "npx playwright test --config=playwright.config.ts",
    "playwright:update": "npx playwright test --config=playwright.config.ts --update-snapshots",
    "audit": "npm audit --audit-level low",
    "eslint": "eslint . --config ./eslint.config.js --cache",
    "eslint:fix": "eslint . --config ./eslint.config.js --fix",
    "prettier": "prettier --check '**/*.{js,ts,vue,css,html}' --cache",
    "prettier:fix": "prettier --write '**/*.{js,ts,vue,css,html}'",
    "typecheck": "vue-tsc -p ./tsconfig.json",
    "build": "vite --config ./vite.config.ts build"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "chart.js": "^4.6.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-checker": "^1.0.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch": "^10.2.3"
  }
}
